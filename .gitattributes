# Normalise to LF in the repository, whatever the checkout platform does locally.
# Development happens on Windows, CI runs on Linux, and a buyer's machine is unknown -
# without this the first cross-platform checkout rewrites every line of every file and
# the next diff is unreadable.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
*.hdr binary
*.ktx2 binary

# Generated. Collapsed in diffs and excluded from language statistics, because a
# generated file is an output to review as a whole rather than line by line.
src/contract/types.ts linguist-generated=true
package-lock.json linguist-generated=true
